extends ../..//layouts/auth.pug
include ../..//mixins/alert.pug

block main
  .container.mt-5
    .row.justify-content-center
      .col-md-6
        .card.shadow
          .card-header.text-center.bg-primary.text-white
            h4 Đăng nhập 

          .card-body
            +alertError(5000)
            +alertSuccess(5000)

            form(method="POST", action=`${prefixAdmin}/auth/login`)
              .mb-3
                label.form-label(for="email") Email
                input.form-control(
                  type="email",
                  name="email",
                  id="email",
                  placeholder="Nhập email...",
                  required
                )

              .mb-3
                label.form-label(for="password") Mật khẩu
                input.form-control(
                  type="password",
                  name="password",
                  id="password",
                  placeholder="Nhập mật khẩu...",
                  required
                )

              .mb-3.form-check
                input.form-check-input(
                  type="checkbox",
                  id="remember"
                  name="remember"
                )
                label.form-check-label(for="remember") Ghi nhớ đăng nhập

              button.btn.btn-primary.w-100(type="submit") Đăng nhập

          .card-footer.text-center
            a(href="/auth/forgot-password") Quên mật khẩu?
            |  | 
            a(href="/auth/register") Đăng ký tài khoản