extends ../../layouts/default.pug
include ../../mixins/select-tree.pug
block main 
  h1(class="mb-4") Cập nhật danh mục sản phẩm
  form(action=`${prefixAdmin}/products-category/edit/${data.id}?_method=PATCH` id="form-edit-product-category" method="POST" enctype="multipart/form-data")
    div(class="form-group")
      label(for="title") Tiêu đề
      input(
        type="text"
        class="form-control"
        id="title"
        name="title"
        required
        value=data.title
      )
    div(class="form-group") Danh mục cha
      select(name="parent_id", id="parent_id", class="form-control") 
        option(value="")  -- Chọn danh mục cha --
        if(records)
          +select-tree(records, 1, data.parent_id)
    //-   input(
    //-     type="text"
    //-     class="form-control"
    //-     id="parent_id"
    //-     name="parent_id"
    //-   )
    
    div(class="form-group")
      label(for="desc") Mô tả
      textarea(
        class="form-control tiny-mce"
        id="desc"
        name="description"
        rows="5"
      )  #{data.description}
    div(class="form-group" upload-image)
      label(for="thumbnail" class="d-block") Ảnh
      input(
        type="file"
        class="form-control-file d-block"
        style="margin-bottom:15px"
        id="thumbnail"
        name="thumbnail"
        accept="image/*" 
        upload-image-input
      )
    div(class="preview-image ")
      img(src=data.thumbnail upload-image-preview class="d-block" style="width: 100px; height: 100px")
      button(class="close-image") x
      //- lọc ra các file ảnh (chỉ được upload các file ảnh)
    div(class="form-group")
      label(for="position") Vị trí
      input(
        type="number"
        class="form-control"
        id="position"
        name="position"
        placeholder="Tự động tăng"
        min="1"
        value= data.position
      )
    div(class="form-group form-check form-check-inline")
      input(
        type="radio"
        class="form-check-input"
        id="statusActive"
        name="status"
        value="active"
        checked=(data.status == "active")
      )
      label(for="statusActive" class="form-check-label") Hoạt động
    div(class="form-group form-check form-check-inline")
      input(
        type="radio"
        class="form-check-input"
        id="statusInActive"
        name="status"
        value="inactive"
        checked=(data.status == "inactive")
      )
      label(for="statusInActive" class="form-check-label") Dừng hoạt động
    div(class="form-group")
      button(
        type="submit"
        class="btn btn-primary"
      ) Cập nhật
      a(
        type="submit"
        class="btn btn-secondary ms-2"
        href=`${prefixAdmin}/products-category`
        
      ) Trở lại
    
  script(src="/admin/js/product.js")