extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  .container-fluid.mt-4
    +alertSuccess(5000) 
    +alertError(5000)
    // ===== HEADER =====
    .d-flex.justify-content-between.align-items-center.mb-3
      h2.mb-0 Phân quyền
      button.btn.btn-primary(type="submit" button-submit) Cập nhật

    if(records)
      div(data-records=records)
      table.table.table-hover.table-sm(table-permissions)
        thead
          tr
            th Tính năng
            each item in records 
              th.text-center #{item.title}
            

        tbody
          tr(data-name="id" class="d-none")
            td
            each item in records 
              td.text-center
                input(type="text" value=item.id)
          tr
            td(colspan=`${records.length + 1}` class="text-start")
              b Danh mục sản phẩm

          tr(data-name="products-category_view")
            td Xem
            - for(let i=0; i < records.length; i++)
              td.text-center
                input(type="checkbox")

          tr(data-name="products-category_create")
            td Thêm mới
            - for(let i=0; i < records.length; i++)
              td.text-center
                input(type="checkbox")

          tr(data-name="products-category_edit")
            td Chỉnh sửa
            - for(let i=0; i < records.length; i++)
              td.text-center
                input(type="checkbox")

          tr(data-name="products-category_delete")
            td Xóa
            - for(let i=0; i < records.length; i++)
              td.text-center
                input(type="checkbox")
          tr
            td(colspan=`${records.length + 1}` class="text-start")
              b Sản phẩm

          tr(data-name="products_view")
            td Xem
            - for(let i=0; i < records.length; i++)
              td.text-center
                input(type="checkbox")

          tr(data-name="products_create")
            td Thêm mới
            - for(let i=0; i < records.length; i++)
              td.text-center
                input(type="checkbox")

          tr(data-name="products_edit")
            td Chỉnh sửa
            - for(let i=0; i < records.length; i++)
              td.text-center
                input(type="checkbox")

          tr(data-name="products_delete")
          tr
            td(colspan=`${records.length + 1}` class="text-start")
              b Nhóm quyền

          tr(data-name="roles_view")
            td Xem
            - for(let i=0; i < records.length; i++)
              td.text-center
                input(type="checkbox")

          tr(data-name="roles_create")
            td Thêm mới
            - for(let i=0; i < records.length; i++)
              td.text-center
                input(type="checkbox")

          tr(data-name="roles_edit")
            td Chỉnh sửa
            - for(let i=0; i < records.length; i++)
              td.text-center
                input(type="checkbox")

          tr(data-name="roles_delete")
            td Xoá
            - for(let i=0; i < records.length; i++)
              td.text-center
                input(type="checkbox")
          tr(data-name="roles_permissions")
            td Phân quyền
            - for(let i=0; i < records.length; i++)
              td.text-center
                input(type="checkbox")

  form(action=`${prefixAdmin}/roles/permission?_method=PATCH`, method="post" form-change-permission) 
    input(type="text" name="permission" value="" class="d-none")
  script(src="/admin/js/role.js") 