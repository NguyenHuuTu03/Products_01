extends ../../layouts/default.pug

block main
  if(role.permission.includes("roles_create"))
    h1(class="mb-4") Thêm mới nhóm quyền

    form(
      action=`${prefixAdmin}/roles/create`
      method="POST"
    )
      // ===== Tiêu đề =====
      .form-group
        label(for="title") Tiêu đề
        input.form-control(
          type="text"
          id="title"
          name="title"
          required
        )

      // ===== Mô tả =====
      .form-group
        label(for="desc") Mô tả
        input.form-control(
          type="text"
          id="desc"
          name="description"
        )

      // ===== Nút submit =====
      .form-group
      button.btn.btn-primary.mt-3(type="submit") Tạo mới
      a.btn.btn-secondary.mt-3.ms-3(type="submit" href=`${prefixAdmin}/roles`) Trở lại