header.header 
  .container-fluid 
    .row.align-items-center 
      .col-3 
        .inner-logo 
          a(href="/admin/dashboard") ADMIN 

      .col-9.text-end
        if(user)
          a.btn.btn-primary.btn-sm.me-3(href=`${prefixAdmin}/my-account`) #{user.fullName}
          a.btn.btn-danger.btn-sm(href=`${prefixAdmin}/auth/logout`) Đăng xuất
        else
          a.btn.btn-primary.btn-sm(href=`${prefixAdmin}/auth/login`) Đăng nhập