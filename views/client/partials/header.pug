include ../mixins/sub-menu.pug

header.header
  .container 
    .row.align-items-center 

      // ===== LOGO =====
      .col-3 
        .inner-logo 
          a(href="/")
            img(src="/images/logo.png", alt="logo")

      // ===== SEARCH (Ở GIỮA) =====
      .col-4
        .inner-search
          form(action="/search", method="GET")
            input(type="text", name="keyword", placeholder="Tìm sản phẩm..." value=keyword)
            button(type="submit") 🔍

      // ===== MENU =====
      .col-5 
        .inner-menu   
          ul 
            li 
              a(href="/") Trang chủ

            li
              - const path = "/products"
              a(href=path) Sản phẩm
              +sub-menu(layoutProductCategory, path)