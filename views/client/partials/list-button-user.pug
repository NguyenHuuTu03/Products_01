.row
      .col-12
        a(class="btn btn-primary m-1" href="/users/not-friend") Danh sách người dùng
        a(class="btn btn-primary m-1" href="/users/friends") Danh sách bạn bè
          if(countFriend)
            span.badge.bg-light.text-dark(badge-length-friend=user.id) #{countFriend.lengthFriend}
        a(class="btn btn-primary m-1" href="/users/request") Lời mời đã gửi
          if(countFriend)
            span.badge.bg-light.text-dark(badge-length-request=user.id) #{countFriend.lengthRequestFriend}
        a(class="btn btn-primary m-1" href="/users/accept" ) Lời mời kết bạn
          if(countFriend)
            span.badge.bg-light.text-dark(badge-length-accept=user.id) #{countFriend.lengthAcceptFriend}