include ../mixins/alert.pug
doctype 
html 
  head 
    title #{pageTitle}
    // bootstrap
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css")
    // icon
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css")
    // file-upload-with-preview
    link(rel="stylesheet", href="https://unpkg.com/file-upload-with-preview/dist/style.css")
    //- trong pug thì muốn đi vào đường dẫn public thì chỉ cần / là sẽ đi vào public
    link(rel="stylesheet", href="/css/style.css")

  body 
    +alertSuccess(3000)
    +alertError(3000)
    include ../partials/header.pug
    block main 
    include ../partials/footer.pug

    
    // bootstrap
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js") 
    // socket.io
    script(src="/socket.io/socket.io.js")
    script(src="/js/socket.js")
    // emoji-picker
    script(type="module" src="https://cdn.jsdelivr.net/npm/emoji-picker-element@^1/index.js")

    // file-upload-with-preview
    script(type="module" src="https://unpkg.com/file-upload-with-preview/dist/index.js")

    script(type="module" src="/js/chat.js")

    script(src="/js/script.js") 
    