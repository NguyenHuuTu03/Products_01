extends ../../layouts/default.pug
include ../../mixins/box_head.pug

block main
  .container.mt-5
    .row.justify-content-center
      .col-md-5

        .card.shadow-lg.p-4
          // ===== HEADER =====
          h3.text-center.mb-3.text-primary
            +box_head("Xác thực OTP")

          p.text-center.text-muted
            | Nhập mã OTP đã gửi đến email của bạn

          // ===== FORM =====
          form(action="/user/password/otp" method="POST")

            // Email hiển thị (readonly)
            .mb-3
              label.form-label Email
              input.form-control(
                type="email"
                name="email"
                value=email
                readonly
              )

            // Hidden để submit
            //- input(type="hidden" name="email" value=email)

            // OTP
            .mb-3
              label.form-label Mã OTP
              input.form-control.text-center(
                type="text"
                name="otp"
                placeholder="Nhập OTP..."
                required
                maxlength="8"
                style="font-size: 20px; letter-spacing: 6px;"
              )

            button.btn.btn-primary.w-100(type="submit")
              | Xác nhận

          // ===== COUNTDOWN =====
          //- .text-center.mt-3
          //-   span.text-muted Mã OTP hết hạn sau: 
          //-   span#countdown.text-danger 60s

          // ===== RESEND =====
          .text-center.mt-2
            a#resendLink.text-decoration-none(href=`/user/password/forgot?email=${email}`) 
              | Gửi lại OTP

          hr

          .text-center
            a(href="/user/login") ← Quay lại đăng nhập