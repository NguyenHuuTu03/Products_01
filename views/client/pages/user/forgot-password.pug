extends ../../layouts/default.pug
include ../../mixins/box_head.pug

block main
  .container.mt-5
    .row.justify-content-center
      .col-md-5

        .card.shadow-lg.p-4
          h3.text-center.mb-4.text-warning
            +box_head("Quên mật khẩu")

          p.text-center.mb-3
            | Nhập email của bạn để nhận hướng dẫn đặt lại mật khẩu

          form(action="/user/password/forgot" method="POST")

            .mb-3
              label.form-label Email
              input.form-control(
                type="email"
                name="email"
                placeholder="Nhập email..."
                required
              )

            button.btn.btn-warning.w-100(type="submit")
              | Gửi yêu cầu

          hr

          .text-center
            a(href="/user/login") ← Quay lại đăng nhập