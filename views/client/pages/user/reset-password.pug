extends ../../layouts/default.pug
include ../../mixins/box_head.pug

block main
  .container.mt-5
    .row.justify-content-center
      .col-md-5

        .card.shadow-lg.p-4
          // ===== HEADER =====
          h3.text-center.mb-3.text-success
            +box_head("Đặt lại mật khẩu")

          p.text-center.text-muted
            | Vui lòng nhập mật khẩu mới cho tài khoản của bạn

          // ===== FORM =====
          form(action="/user/password/reset" method="POST")

            // Password mới
            .mb-3
              label.form-label Mật khẩu mới
              input.form-control(
                type="password"
                name="password"
                placeholder="Nhập mật khẩu mới..."
                required
                minlength="6"
              )

            // Nhập lại password
            .mb-3
              label.form-label Nhập lại mật khẩu
              input.form-control(
                type="password"
                name="confirmPassword"
                placeholder="Nhập lại mật khẩu..."
                required
              )

            button.btn.btn-success.w-100(type="submit")
              | Cập nhật mật khẩu

          hr

          .text-center
            a(href="/user/login") ← Quay lại đăng nhập
