extends ../../layouts/default.pug
include ../../mixins/box_head.pug

block main
  .container.mt-5
    .row.justify-content-center
      .col-md-5

        .card.shadow-lg.p-4
          h3.text-center.mb-4.text-success
            +box_head("Đăng nhập")

          form(action="/user/login" method="POST")

            .mb-3
              label.form-label Email
              input.form-control(
                type="email"
                name="email"
                placeholder="Nhập email..."
                required
              )

            .mb-3
              label.form-label Mật khẩu
              input.form-control(
                type="password"
                name="password"
                placeholder="Nhập mật khẩu..."
                required
              )

            button.btn.btn-success.w-100.mt-2(type="submit")
              | Đăng nhập

          hr

          .text-center
            p.mb-1
              a(href="#") Quên mật khẩu?
            p
              | Chưa có tài khoản? 
              a(href="/user/register") Đăng ký ngay