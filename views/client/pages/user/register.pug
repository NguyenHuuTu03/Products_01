extends ../../layouts/default.pug
include ../../mixins/box_head.pug

block main
  .container.mt-5
    .row.justify-content-center
      .col-md-5

        .card.shadow-lg.p-4
          h3.text-center.mb-4.text-primary 
            +box_head("Đăng ký tài khoản")

          form(action="/user/register" method="POST")

            .mb-3
              label.form-label Họ tên
              input.form-control(
                type="text"
                name="fullName"
                placeholder="Nhập họ tên..."
                required
              )

            .mb-3
              label.form-label Email
              input.form-control(
                type="email"
                name="email"
                placeholder="Nhập email..."
                required
              )

            .mb-3
              label.form-label Mật khẩu
              input.form-control(
                type="password"
                name="password"
                placeholder="Nhập mật khẩu..."
                required
              )

            button.btn.btn-primary.w-100.mt-2(type="submit")
              | Đăng ký

          hr

          p.text-center.mt-2
            | Đã có tài khoản? 
            a(href="/users/login") Đăng nhập