extends ../../layouts/default.pug
include ../../mixins/box_head.pug


block main
  .container.mt-4
    .row 
      include ../../partials/list-button-user.pug
    h3.mb-4 
      +box_head(pageTitle)

    .row
      each user in users
        .col-9.mb-2
          .box-user.add
            .inner-avatar
              img(
                src=user.avatar ? user.avatar : "/images/avatar.png",
                alt=user.fullName
              )

            .inner-info
              .inner-name= user.fullName

              .inner-buttons
                a.btn.btn-sm.btn-primary.me-1(
                  href="#"
                ) Nhắn tin

                button.btn.btn-sm.btn-secondary.me-1(
                  btn-unfriend-friend=user.id
                ) Xoá kết bạn
              .inner-status(status=user.statusOnline)
                i(class="fa-solid fa-circle")
block script 
  script(src="/js/users.js") 