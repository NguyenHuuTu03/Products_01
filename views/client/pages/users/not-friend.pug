extends ../../layouts/default.pug
include ../../mixins/box_head.pug

block main
  .container.mt-4
    h3.mb-4 
      +box_head("Danh sách người dùng")

    .row
      each user in users
        .col-9.mb-2
          .box-user
            .inner-avatar
              img(
                src=user.avatar ? user.avatar : "/images/avatar.png",
                alt=user.fullName
              )

            .inner-info
              .inner-name= user.fullName

              .inner-buttons
                button.btn.btn-sm.btn-primary.me-1(
                  btn-add-friend=user.id
                ) Kết bạn

                button.btn.btn-sm.btn-secondary.me-1(
                  btn-cancel-friend=user.id
                ) Huỷ
                